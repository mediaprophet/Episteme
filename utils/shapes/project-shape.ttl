@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix schema: <https://schema.org/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dc:     <http://purl.org/dc/terms/> .
@prefix ep:     <https://episteme.example/shapes/> .

# ─── Project Shape ────────────────────────────────────────────────────────────
#
# Validates the core Description of a Project (DOAP) resource.
# The project must be a:
#   doap:Project, schema:Project, prov:Entity
# with standard DOAP fields and provenance.
#
ep:ProjectShape
    a sh:NodeShape ;
    rdfs:label "DOAP Project Shape" ;
    rdfs:comment "Validates a Solid Pod project resource matching DOAP, Schema.org, and PROV ontologies." ;
    sh:targetClass doap:Project ;

    # ── Multi-typing ──────────────────────────────────────────────────────────
    sh:property [
        sh:path  rdf:type ;
        sh:hasValue schema:Project ;
        sh:minCount 1 ;
        sh:message "Project must also be typed as schema:Project." ;
    ] ;

    sh:property [
        sh:path  rdf:type ;
        sh:hasValue prov:Entity ;
        sh:minCount 1 ;
        sh:message "Project must be typed as prov:Entity for provenance tracking." ;
    ] ;

    # ── DOAP required fields ──────────────────────────────────────────────────
    sh:property [
        sh:path     doap:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "doap:name is required and must be a single string." ;
    ] ;

    sh:property [
        sh:path     doap:maintainer ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "doap:maintainer must link to at least one WebID (IRI)." ;
    ] ;

    sh:property [
        sh:path     doap:created ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:message  "doap:created timestamp is required." ;
    ] ;

    # ── Provenance ────────────────────────────────────────────────────────────
    sh:property [
        sh:path     prov:wasAttributedTo ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "prov:wasAttributedTo must link to the creator's WebID." ;
    ] ;

    # ── Hosting Provider ──────────────────────────────────────────────────────
    sh:property [
        sh:path     schema:hostingProvider ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "Project must specify a schema:hostingProvider IRI." ;
    ] .
