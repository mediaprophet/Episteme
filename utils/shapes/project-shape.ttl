@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix schema: <https://schema.org/> .
@prefix odrl:   <http://www.w3.org/ns/odrl/2/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dc:     <http://purl.org/dc/terms/> .
@prefix hef-lc: <http://example.org/humanitarian-equity-framework/ontology/license#> .
@prefix hef-co: <http://example.org/humanitarian-equity-framework/ontology/cost-model#> .
@prefix hef-cl: <http://example.org/humanitarian-equity-framework/ontology/claims-procedure#> .
@prefix hcai:   <https://w3id.org/hcai/agreements#> .
@prefix ep:     <https://episteme.example/shapes/> .

# ─── Project Shape ────────────────────────────────────────────────────────────
#
# Validates the core Webizen Co-Stewardship Project resource.
# The project must simultaneously be a:
#   doap:Project, schema:Project, schema:CreativeWork, prov:Entity
# with all mandatory fields from DOAP and ODRL governance.
#
ep:ProjectShape
    a sh:NodeShape ;
    rdfs:label "Webizen Co-Stewardship Project Shape" ;
    rdfs:comment "Validates a Solid Pod project resource enriched with DOAP, Schema.org, HEF, and ODRL vocabularies." ;
    sh:targetClass doap:Project ;

    # ── Multi-typing ──────────────────────────────────────────────────────────
    sh:property [
        sh:path  rdf:type ;
        sh:hasValue schema:Project ;
        sh:minCount 1 ;
        sh:message "Project must also be typed as schema:Project." ;
    ] ;

    sh:property [
        sh:path  rdf:type ;
        sh:hasValue prov:Entity ;
        sh:minCount 1 ;
        sh:message "Project must be typed as prov:Entity for provenance tracking." ;
    ] ;

    # ── DOAP required fields ──────────────────────────────────────────────────
    sh:property [
        sh:path     doap:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "doap:name is required and must be a single string." ;
    ] ;

    sh:property [
        sh:path     doap:maintainer ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "doap:maintainer must link to at least one WebID (IRI)." ;
    ] ;

    sh:property [
        sh:path     doap:license ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "doap:license must link to the HEF license resource." ;
    ] ;

    sh:property [
        sh:path     doap:created ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:message  "doap:created timestamp is required." ;
    ] ;

    # ── ODRL governance ───────────────────────────────────────────────────────
    sh:property [
        sh:path     odrl:hasPolicy ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "Project must reference an ODRL Policy via odrl:hasPolicy." ;
    ] ;

    # ── HEF Claim Process link ────────────────────────────────────────────────
    sh:property [
        sh:path     hef-cl:hasClaimProcess ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "Project must reference an HEF ClaimProcess resource." ;
    ] ;

    # ── Provenance ────────────────────────────────────────────────────────────
    sh:property [
        sh:path     prov:wasAttributedTo ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "prov:wasAttributedTo must link to the creator's WebID." ;
    ] .

# ─── ODRL Policy Shape ────────────────────────────────────────────────────────
ep:PolicyShape
    a sh:NodeShape ;
    rdfs:label "Webizen Co-Stewardship ODRL Policy Shape" ;
    sh:targetClass odrl:Policy ;

    sh:property [
        sh:path     odrl:assigner ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "odrl:Policy must have at least one assigner WebID." ;
    ] ;

    sh:property [
        sh:path     odrl:assignee ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "odrl:Policy must have at least one assignee (co-steward) WebID." ;
    ] ;

    sh:property [
        sh:path     odrl:action ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message  "odrl:Policy must specify at least one permitted action." ;
    ] ;

    sh:property [
        sh:path     hcai:valueCredential ;
        sh:minCount 1 ;
        sh:message  "ODRL Policy must reference a UN Human Rights value credential URI." ;
    ] .

# ─── HEF Obligation Cost Shape ────────────────────────────────────────────────
ep:ObligationCostShape
    a sh:NodeShape ;
    rdfs:label "HEF Obligation Cost Shape" ;
    sh:targetClass hef-co:ObligationCost ;

    sh:property [
        sh:path     schema:currency ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message  "ObligationCost must specify a currency." ;
    ] ;

    sh:property [
        sh:path     schema:value ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message  "ObligationCost must specify an initial numeric value." ;
    ] .
