{
  "name": "episteme",
  "version": "0.0.3",
  "description": "Episteme: The Human-Centric AI Architecture for W3C Solid",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "css:start": "community-solid-server -l info -m .",
    "sync-rules": "node scripts/sync-rules.js"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "react": "^18.0.0",
    "@types/react": "^18.0.0",
    "vitest": "^1.6.0",
    "@solid/community-server": "^7.0.0",
    "@inrupt/solid-client": "^2.0.0",
    "@inrupt/solid-client-authn-node": "^2.0.0",
    "@inrupt/solid-client-authn-browser": "^2.0.0",
    "@inrupt/vocab-common-rdf": "^1.0.5"
  }
}
