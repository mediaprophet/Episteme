## 2. Concrete Code Example

Here is a TypeScript implementation of a secure, permission-aware **MCP Tool Handler** that reads a file from a Solid Pod:

```typescript
import { getSolidDataset, getThing, getStringNoLocale } from "@inrupt/solid-client";
import { fetch as solidFetch } from "@inrupt/solid-client-authn-browser";

interface McpToolRequest {
  resourceUri: string;
  propertyUri: string;
  userSessionToken?: string; // Delegated DPoP-bound token
}

/**
 * MCP tool implementation to read a specific predicate value from a Pod resource
 */
export async function handleMcpReadTool(request: McpToolRequest) {
  const { resourceUri, propertyUri, userSessionToken } = request;

  try {
    // 1. Establish the authenticated fetch context.
    // In a server environment, wrap fetch with the user's delegated DPoP headers.
    const customFetch = userSessionToken 
      ? (url: string, init?: RequestInit) => {
          const headers = new Headers(init?.headers || {});
          headers.set("Authorization", `Bearer ${userSessionToken}`);
          return fetch(url, { ...init, headers });
        }
      : solidFetch; // Fallback to local session fetch

    // 2. Fetch dataset (will fail with 401/403 if token lacks permissions)
    const dataset = await getSolidDataset(resourceUri, { fetch: customFetch });

    // 3. Extract requested properties
    const thing = getThing(dataset, resourceUri);
    if (!thing) {
      return {
        isError: true,
        content: [{ type: "text", text: `Resource thing not found at: ${resourceUri}` }]
      };
    }

    const value = getStringNoLocale(thing, propertyUri);
    if (value === null) {
      return {
        isError: true,
        content: [{ type: "text", text: `Predicate ${propertyUri} not found in resource.` }]
      };
    }

    return {
      isError: false,
      content: [{ type: "text", text: value }]
    };

  } catch (error: any) {
    // 4. Gracefully catch access errors, ensuring the AI agent receives the exact reason
    return {
      isError: true,
      content: [{ type: "text", text: `Access Denied or Read Error: ${error.message}` }]
    };
  }
}
```

